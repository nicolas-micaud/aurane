{
  "name": "aurane",
  "version": "0.1.0",
  "private": true,
  "description": "Aurane — can't stop the signal. Free, persistent, web-only MMO strategy by ninabot.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "season": "npm run -w @aurane/season-sim start --"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "eslint": "^9.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vitest": "^2.1.4"
  }
}
